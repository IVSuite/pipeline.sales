# ---------------------------------------------------------------------------
# Backend: the IV-Suite central Supabase project (ref `hpgfwtezgrzbzqsdotkt`).
# The CRM tables live in the `crm` schema there, NOT in `public` — `public` on
# that project belongs to the quotation app. Find URL/keys in the Supabase
# Dashboard > Project Settings > API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://hpgfwtezgrzbzqsdotkt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# PostgREST schema every Supabase client targets. Must be `crm` on IV-Suite.
# `crm` must also be listed under Dashboard > Settings > API > Exposed schemas.
# Rollback to the retired standalone `pipeline-sales-crm` project = point the
# URL/key back at it and set this to `public`. No code change required.
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=crm

# Service role key — SERVER ONLY, never expose to the browser or commit it.
# Bypasses RLS on the CENTRAL database; only set it if something actually needs
# it. Nothing in `src/` uses it today (only `scripts/wipe-data.mjs`, which is
# destructive and guarded).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
