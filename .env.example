# Supabase project settings — find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never expose to the browser or commit it.
# Used sparingly for admin-only operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
